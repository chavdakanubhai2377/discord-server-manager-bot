# Discord Bot Environment Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (Get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Prefix (Command prefix, e.g., ! for !help)
BOT_PREFIX=!

# MongoDB Configuration (Optional - for persistent data storage)
MONGODB_URI=mongodb://localhost:27017/discord_bot
MONGODB_USER=admin
MONGODB_PASSWORD=your_password

# MongoDB Atlas (Cloud) Configuration
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# Bot Settings
BOT_NAME=TableMC Development
BOT_VERSION=1.0.0
BOT_DESCRIPTION=A comprehensive Discord bot for server management

# Owner Configuration
OWNER_ID=your_user_id_here
OWNER_EMAIL=chavdakanubhai2377@gmail.com

# Server Configuration
DEFAULT_GUILD_ID=your_server_id_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Features Toggle
ENABLE_LEVELING=true
ENABLE_MODERATION=true
ENABLE_WELCOME=true
ENABLE_FUN=true
ENABLE_UTILITY=true

# API Keys (Optional)
# WEATHER_API_KEY=your_weather_api_key
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Database Backup
# BACKUP_ENABLED=true
# BACKUP_INTERVAL=86400  # 24 hours in seconds

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=5
RATE_LIMIT_PERIOD=60  # seconds

# Development Mode
DEBUG=false
DEVELOPMENT_MODE=false
